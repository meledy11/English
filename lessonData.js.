// ВСПОМОГАТЕЛЬНЫЕ
// ═══════════════════════════════════════════════
function _shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
}

// Найти запись по слову (регистр не важен)
function findLesson(word) {
    if (!word) return null;
    const key = word.toLowerCase().trim();
    return LESSON_DATA.find(w => w.eng.toLowerCase() === key) || null;
}

// Все уникальные слова
function getAllLessonWords() {
    return LESSON_DATA;
}

// Получить предложение для слова
function getLessonSentence(wordOrRecord) {
    const rec = typeof wordOrRecord === 'string' ? findLesson(wordOrRecord) : wordOrRecord;
    if (!rec) return null;
    return { en: rec.ex, ru: rec.exRu, word: rec };
}

// Получить вопрос для слова
function getLessonQuestion(wordOrRecord) {
    const rec = typeof wordOrRecord === 'string' ? findLesson(wordOrRecord) : wordOrRecord;
    if (!rec || !rec.q) return null;
    return { en: rec.q, ru: rec.qRu, word: rec };
}

// Список предложений
function lessonSentencesList(words, count = 15) {
    const source = words && words.length ? words : LESSON_DATA;
    const withEx = source.filter(w => w.ex && w.exRu);
    if (!withEx.length) return [];
    return _shuffle(withEx).slice(0, count).map(w => ({
        en: w.ex,
        ru: w.exRu,
        word: w
    }));
}

// Список вопросов
function lessonQuestionsList(words, count = 15) {
    const source = words && words.length ? words : LESSON_DATA;
    const withQ = source.filter(w => w.q && w.qRu);
    if (!withQ.length) return [];
    return _shuffle(withQ).slice(0, count).map(w => ({
        en: w.q,
        ru: w.qRu,
        word: w
    }));
}

// Генерация теста (7 типов)
function lessonQuiz(words, count = 10) {
    const source = words && words.length ? words : LESSON_DATA;
    const sample = _shuffle(source).slice(0, count * 3);
    const questions = [];

    for (const w of sample) {
        if (questions.length >= count) break;
        const others = _shuffle(source.filter(o =>
            o.eng !== w.eng && o.pos === w.pos
        )).slice(0, 4);

        if (others.length < 3) continue;

        const types = _shuffle(['en2ru', 'ru2en', 'trans', 'fill', 'sent-ru', 'sent-en']);
        const type = types[0];

        let q = null;

        if (type === 'en2ru') {
            q = {
                type: 'en2ru',
                q: `Как переводится <b>${w.eng}</b>?`,
                correct: w.ru,
                options: _shuffle([w.ru, ...others.map(o => o.ru)]).slice(0, 4),
                hint: `${w.tr || ''} · ${w.pos}`
            };
        } else if (type === 'ru2en') {
            q = {
                type: 'ru2en',
                q: `Как по-английски «<b>${w.ru}</b>»?`,
                correct: w.eng,
                options: _shuffle([w.eng, ...others.map(o => o.eng)]).slice(0, 4),
                hint: w.pos
            };
        } else if (type === 'trans' && w.tr) {
            const oth = others.filter(o => o.tr);
            if (oth.length < 3) continue;
            q = {
                type: 'transcription',
                q: `Какая транскрипция у слова <b>${w.eng}</b>?`,
                correct: w.tr,
                options: _shuffle([w.tr, ...oth.slice(0, 3).map(o => o.tr)]),
                hint: w.ru
            };
        } else if (type === 'fill' && w.ex) {
            const re = new RegExp('\\b' + w.eng.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\w*\\b', 'i');
            if (!re.test(w.ex)) continue;
            q = {
                type: 'fill',
                q: `Вставь пропущенное слово:<br><b>${w.ex.replace(re, '___')}</b>`,
                correct: w.eng,
                options: _shuffle([w.eng, ...others.slice(0, 3).map(o => o.eng)]),
                hint: w.exRu
            };
        } else if (type === 'sent-ru' && w.ex) {
            const wrong = others
                .filter(o => o.exRu && o.exRu !== w.exRu)
                .slice(0, 3)
                .map(o => o.exRu);
            if (wrong.length < 3) continue;
            q = {
                type: 'sentence-ru',
                q: `Как переводится предложение?<br><b>${w.ex}</b>`,
                correct: w.exRu,
                options: _shuffle([w.exRu, ...wrong]),
                hint: `${w.eng} — ${w.ru}`
            };
        } else if (type === 'sent-en' && w.ex) {
            const wrong = others
                .filter(o => o.ex && o.ex !== w.ex)
                .slice(0, 3)
                .map(o => o.ex);
            if (wrong.length < 3) continue;
            q = {
                type: 'sentence-en',
                q: `Как сказать по-английски?<br><b>${w.exRu}</b>`,
                correct: w.ex,
                options: _shuffle([w.ex, ...wrong]),
                hint: `${w.eng} — ${w.ru}`
            };
        }

        if (q && q.options) {
            const unique = [...new Set(q.options)];
            if (unique.length >= 2 && unique.includes(q.correct)) {
                q.options = _shuffle(unique);
                q.word = w;
                questions.push(q);
            }
        }
    }
    return questions;
}

